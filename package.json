{
  "name": "safepush-dev",
  "version": "0.1.0",
  "description": "Local-first security guardrails for AI-built Next.js and Vite projects",
  "type": "module",
  "bin": {
    "safepush": "./dist/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
