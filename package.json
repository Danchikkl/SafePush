{
  "name": "@danchikkl/safepush",
  "version": "0.1.0",
  "description": "Local secret guardrails for AI coding agents: CLI, Claude Code hook and MCP server. No network, no telemetry.",
  "type": "module",
  "bin": {
    "safepush": "./dist/cli.mjs",
    "safepush-mcp": "./dist/mcp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node scripts/build-plugin.mjs && npm test",
    "prepack": "npm run build",
    "demo": "npm run build && node scripts/demo.mjs",
    "mcp": "node dist/mcp.mjs",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danchikkl/SafePush.git"
  },
  "homepage": "https://github.com/Danchikkl/SafePush#readme",
  "bugs": {
    "url": "https://github.com/Danchikkl/SafePush/issues"
  },
  "author": "Danchikkl",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "security",
    "vibe-coding",
    "secrets",
    "nextjs",
    "vite",
    "git-hooks",
    "open-source",
    "mcp",
    "claude-code",
    "codex",
    "claude-code-plugin",
    "hooks",
    "guardrails",
    "secret-scanning"
  ],
  "license": "MIT"
}
